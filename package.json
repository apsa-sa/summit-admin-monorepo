{
  "name": "summit-admin-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "tsx apps/web-admin/server/main.ts",
    "build": "tsc --noEmit && tsc -p apps/web-admin/tsconfig.browser.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/testing/*.test.ts",
    "db:migrate": "tsx tooling/scripts/database.ts migrate",
    "db:seed": "tsx tooling/scripts/database.ts seed",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "turbo": "2.11.10"
  }
}
