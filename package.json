{
  "name": "summit-admin-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "node --import tsx apps/web-admin/server/main.ts",
    "build": "pnpm build:packages && tsc --noEmit && tsc -p apps/web-admin/tsconfig.browser.json && node --experimental-vm-modules --import tsx tooling/scripts/browser-asset-contract.ts",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "test": "pnpm build:packages && node --import tsx --test packages/testing/*.test.ts",
    "db:migrate": "node --import tsx tooling/scripts/database.ts migrate",
    "db:seed": "node --import tsx tooling/scripts/database.ts seed",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:packages",
    "audit:publication": "node --import tsx tooling/scripts/publication-audit.ts",
    "proof:build": "turbo run build --filter=@summit/next-proof",
    "proof:dev": "pnpm --filter @summit/next-proof dev",
    "proof:start": "pnpm --filter @summit/next-proof start",
    "test:integration": "node --import tsx --test packages/testing/integration/*.test.ts",
    "test:e2e": "playwright test",
    "build:packages": "turbo run build --filter=@summit/ui --filter=@summit/localization",
    "test:packages": "node tooling/scripts/package-contract.mjs",
    "admin:build": "turbo run build --filter=@summit/web-admin",
    "admin:dev": "pnpm --filter @summit/web-admin dev",
    "admin:start": "pnpm --filter @summit/web-admin start",
    "docs:build": "turbo run build --filter=@summit/docs",
    "docs:dev": "pnpm --filter @summit/docs dev",
    "docs:start": "pnpm --filter @summit/docs start"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "turbo": "2.11.10",
    "@playwright/test": "1.64.1",
    "@summit/design-tokens": "workspace:*",
    "@summit/localization": "workspace:*",
    "@summit/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@axe-core/playwright": "4.14.0",
    "fflate": "0.8.3"
  }
}
