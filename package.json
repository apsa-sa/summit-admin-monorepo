{
  "name": "summit-admin-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "node --import tsx apps/web-admin/server/main.ts",
    "build": "tsc --noEmit && tsc -p apps/web-admin/tsconfig.browser.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/testing/*.test.ts",
    "db:migrate": "node --import tsx tooling/scripts/database.ts migrate",
    "db:seed": "node --import tsx tooling/scripts/database.ts seed",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "audit:publication": "node --import tsx tooling/scripts/publication-audit.ts",
    "proof:build": "pnpm --filter @summit/next-proof build",
    "proof:dev": "pnpm --filter @summit/next-proof dev",
    "proof:start": "pnpm --filter @summit/next-proof start",
    "test:integration": "node --import tsx --test packages/testing/integration/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "turbo": "2.11.10",
    "@playwright/test": "1.64.1"
  }
}
