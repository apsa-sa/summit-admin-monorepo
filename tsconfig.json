{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tooling/**/*.ts"
  ],
  "exclude": [
    "apps/next-proof/**",
    "node_modules",
    "packages/ui/src/**",
    "**/dist/**",
    "apps/web-admin/app/**",
    "apps/web-admin/next/**",
    "apps/web-admin/presentation/**",
    "apps/web-admin/proxy.ts",
    "apps/web-admin/next.config.ts",
    "apps/docs/**"
  ]
}
