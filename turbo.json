{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {},
    "test": {},
    "@summit/web-admin#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/application/*.ts",
        "$TURBO_ROOT$/packages/auth/*.ts",
        "$TURBO_ROOT$/packages/contracts/*.ts",
        "$TURBO_ROOT$/packages/core/*.ts",
        "$TURBO_ROOT$/packages/core-rbac/*.ts",
        "$TURBO_ROOT$/packages/data-access/*.ts",
        "$TURBO_ROOT$/packages/exports/*.ts",
        "$TURBO_ROOT$/packages/observability/*.ts",
        "$TURBO_ROOT$/packages/security/*.ts",
        "$TURBO_ROOT$/packages/data-access/migrations/*.sql"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  },
  "globalDependencies": [
    "tooling/typescript/library.json",
    "tooling/scripts/library-build.mjs",
    "tooling/scripts/run-next.mjs"
  ]
}
